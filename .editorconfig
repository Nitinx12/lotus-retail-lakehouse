root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.sql]
indent_size = 4

[*.{R,r,Rmd}]
indent_size = 2

[*.sh]
indent_size = 2

[*.{tex,Rnw}]
indent_size = 2

[Dockerfile*]
indent_size = 4

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{csv,tsv}]
insert_final_newline = false
trim_trailing_whitespace = false
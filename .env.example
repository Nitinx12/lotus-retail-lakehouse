# ============================================================================
# Lotus Retail Lakehouse local development bootstrap ONLY.
#
# This file is for spinning up docker-compose / local Airflow against sandbox
# or dev resources. It must never contain real staging/prod credentials.
#
# Staging and production secrets live in the secrets backend (Vault / cloud
# secrets manager) and are exposed to Airflow as Connections/Variables and to
# Databricks as secret scopes. See ARCHITECTURE.md, Section 10.
#
# Copy this file to .env for local use. Never commit the real .env.
# NOTE: every decorative line in this file starts with #. Bare text lines
# would break "source .env" in the bash wrappers, so keep the # prefix.
# ============================================================================

# ========================================
# Environment
# ========================================
LOTUS_ENV=dev                     # dev | staging | prod (staging/prod resolve secrets from Vault, not this file)

# ========================================
# Postgres Configuration
# ========================================

POSTGRES_GOLD_HOST=localhost
POSTGRES_GOLD_PORT=5432
POSTGRES_GOLD_DB=lotus_gold_dev
POSTGRES_GOLD_USER=lotus_pipeline
POSTGRES_GOLD_PASSWORD=changeme-local-dev-password
# --- Pooler, app and dashboard traffic goes through PgBouncer ---
POSTGRES_GOLD_POOL_HOST=localhost
POSTGRES_GOLD_POOL_PORT=6432
POSTGRES_GOLD_POOL_USER=lotus_app
POSTGRES_GOLD_POOL_PASSWORD=changeme-local-dev-password

# --- Ops schema (pipeline_runs, quality_results, schema_changes) ---
POSTGRES_OPS_HOST=localhost
POSTGRES_OPS_PORT=5432
POSTGRES_OPS_DB=lotus_ops_dev
POSTGRES_OPS_USER=lotus_ops
POSTGRES_OPS_PASSWORD=changeme-local-dev-password

# --- PII restricted role, used only by the ops/admin path, never by Streamlit ---
POSTGRES_PII_READER_USER=lotus_pii_reader
POSTGRES_PII_READER_PASSWORD=changeme-local-dev-password

# ========================================
# MongoDB Configuration
# ========================================
# --- Raw landing zone ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=lotus_retail
MONGO_DB=lotus_retail             # legacy alias honored by extract_to_mongo.py

# ========================================
# Kaggle Configuration
# ========================================
# --- Used by scripts/extract_to_mongo.py via kagglehub ---
KAGGLE_DATASET=changeme-dataset-slug
KAGGLE_USERNAME=changeme
KAGGLE_KEY=changeme

# ========================================
# Databricks Configuration
# ========================================
DATABRICKS_HOST="https://<your-workspace>.cloud.databricks.com"
DATABRICKS_TOKEN=changeme-local-dev-token
DATABRICKS_JOB_CLUSTER_ID=changeme
DATABRICKS_CATALOG=dev_lotus            # dev_lotus | staging_lotus | prod_lotus

# ========================================
# Airflow Configuration
# ========================================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=changeme-generate-a-real-fernet-key-locally
AIRFLOW_UID=50000

# ========================================
# dbt Configuration
# ========================================
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# ========================================
# Great Expectations Configuration
# ========================================
GE_DATA_CONTEXT_ROOT_DIR=./src/quality

# ========================================
# Alerting Configuration
# ========================================
# --- See ARCHITECTURE.md, Section 12 ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGEME/CHANGEME/CHANGEME
PAGERDUTY_ROUTING_KEY=changeme-only-needed-for-staging-and-prod

# ========================================
# Secrets Backend Configuration
# ========================================
# --- See ARCHITECTURE.md, Section 10 ---
# Local dev typically skips this and uses the plaintext values above instead.
VAULT_ADDR=https://vault.internal.example.com
VAULT_ROLE_ID=changeme
VAULT_SECRET_ID=changeme

# ========================================
# Docker Registry Configuration
# ========================================
# --- See ARCHITECTURE.md, Sections 15 and 16 ---
DOCKERHUB_USERNAME=changeme
DOCKERHUB_TOKEN=changeme
GHCR_TOKEN=changeme

# ========================================
# R Reporting Configuration
# ========================================
REPORT_OUTPUT_DIR=./reports

# ========================================
# Docker Stack Configuration
# ========================================
# --- Values interpolated by docker/docker-compose.yml ---
# The compose file interpolates these from the shell environment, so export
# them first (scripts/docker_up.sh does this for you). Place raw seed CSVs
# in ./data/raw before running the pipeline profile; data/ stays gitignored.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-superuser-password
POSTGRES_DB=lotus_gold_dev
LOTUS_APP_PASSWORD=changeme-app-password
LOTUS_PIPELINE_PASSWORD=changeme-pipeline-password
LOTUS_API_READER_PASSWORD=changeme-api-reader-password
AIRFLOW_DB_PASSWORD=changeme-airflow-password
MONGO_ROOT_USER=mongo_root
MONGO_ROOT_PASSWORD=changeme-mongo-root-password
MONGO_READER_USER=lotus_reader
MONGO_READER_PASSWORD=changeme-mongo-reader-password
SEED_DROP=0
IMAGE_TAG=dev
DOCKERHUB_NAMESPACE=nitinx12
